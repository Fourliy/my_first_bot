TELEGRAM_TOKEN=
# Ключ OpenRouter (https://openrouter.ai/keys). Подойдёт и OPENROUTER_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_TEXT=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
# Локальный Ollama вместо OpenRouter:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_TEXT=llama3.2:1b
LOG_LEVEL=INFO
# Трассировка LangSmith: при true нужен LANGSMITH_API_KEY.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
# Необязательно: проект в LangSmith.
# LANGSMITH_PROJECT=
