TELEGRAM_TOKEN=
# Облако OpenRouter. Для локального Ollama не используется.
# OPENROUTER_API_KEY=
# MODEL_NAME=openai/gpt-4o-mini
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
MODEL_TEXT=llama3.2:1b
MODEL_IMAGE=llava:7b
LOG_LEVEL=INFO
# Правило оповещения: должны совпасть все заданные условия.
ALERT_PATTERN=#alert
ALERT_CHAT_ID=
ALERT_SENDER_ID=
# Куда слать уведомления о заявках; пусто — в чат, где было оповещение.
NOTIFY_CHAT_ID=
